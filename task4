#include <algorithm>
#include <functional>
#include <iostream>
#include <vector>

using namespace std;
using namespace std::placeholders;  

int main() {
    int K;
    cout << "Enter const K: ";
    cin >> K;

    size_t n;
    cout << "Enter the size of the vectorsв: ";
    cin >> n;

    vector<int> V1(n), V2(n);
    cout << "Enter " << n << " elements V1: ";
    for (auto& x : V1) cin >> x;
    cout << "Enter " << n << " elements V2: ";
    for (auto& x : V2) cin >> x;

    transform(V1.begin(), V1.end(),   
              V2.begin(),              
              V1.begin(),              
              bind(plus<>(),          
                   bind(multiplies<>(), _1, K),
                   _2));

    cout << "Result (V1[i]*K + V2[i]): ";
    for (int x : V1) cout << x << ' ';
    cout << endl;
}