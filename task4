#include <algorithm>
#include <functional> 
#include <iostream>
#include <vector>

using namespace std;

int main() {
    const int K = 3;
    vector<int> V1 = {1, 2, 3, 4};
    vector<int> V2 = {5, 6, 7, 8}; 

    transform(V1.begin(), V1.end(),   
                   V2.begin(),             
                   V1.begin(),             
                   bind(plus<>(),                       
                             bind(multiplies<>(),       
                                       placeholders::_1,    
                                       K),                       
                             placeholders::_2));             

    for (int x : V1) cout << x << ' ';
}