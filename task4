#include <algorithm>
#include <functional>
#include <iostream>
#include <vector>
#include <iterator>   

using namespace std;
using namespace std::placeholders;

int main() {
    int K;
    cout << "Enter const K: ";
    cin >> K;

    size_t n;
    cout << "Enter the size of the vectors: ";
    cin >> n;

    vector<int> V1(n), V2(n);

    cout << "Enter " << n << " elements V1: ";
    copy_n(istream_iterator<int>(cin), n, V1.begin());

    cout << "Enter " << n << " elements V2: ";
    copy_n(istream_iterator<int>(cin), n, V2.begin());

    transform(V1.begin(), V1.end(),
              V2.begin(),
              V1.begin(),
              bind(plus<>(),
                   bind(multiplies<>(), _1, K),
                   _2));

    cout << "Result (V1[i]*K + V2[i]): ";
    copy(V1.begin(), V1.end(), ostream_iterator<int>(cout, " "));
    cout << endl;

    return 0;
}